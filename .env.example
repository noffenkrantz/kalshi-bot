# Copy this file to .env and fill in your values. Never share or upload .env.

# Claude API key (Phase 1+), from the Anthropic Console
ANTHROPIC_API_KEY=

# Kalshi PRACTICE (demo) account key (Phase 2+). Made at demo.kalshi.co, NOT the real site.
KALSHI_DEMO_API_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=secrets/kalshi-demo.key

# Real-money keys. Leave blank. Live mode is locked anyway.
KALSHI_PROD_API_KEY_ID=
KALSHI_PROD_PRIVATE_KEY_PATH=
